{
  "name": "generic-canonical",
  "tool": "generic-canonical",
  "command": "zentty-bench-agent",
  "real_binary_names": ["zentty-bench-agent"],
  "version_args": ["--version"],
  "launch_args_by_scenario": {
    "smoke": [
      "printf ZENTTY_AGENT_BENCH_OK"
    ],
    "session_capture": [
      "printf ZENTTY_AGENT_BENCH_OK"
    ],
    "approval": [
      "--approval",
      "printf ZENTTY_AGENT_BENCH_APPROVAL_OK"
    ],
    "restore_launch": [
      "--resume",
      "bench_zenttyrestore"
    ]
  },
  "expectations": {
    "smoke": {
      "required_events": ["session.start", "agent.running", "agent.idle"]
    },
    "session_capture": {
      "required_events": ["session.start", "agent.running", "agent.idle"],
      "session_identity": {
        "session_id_pattern": "regex:^bench_[a-z0-9]+$",
        "tracked_pid": true
      }
    },
    "approval": {
      "required_events": ["session.start", "agent.needs-input"]
    },
    "restore_launch": {
      "required_events": [],
      "required_bootstrap_arguments": [["--resume", "bench_zenttyrestore"]]
    }
  },
  "input_by_scenario": {
    "approval": [
      {
        "after": 2,
        "text": "y\n"
      }
    ]
  },
  "skip_patterns": []
}
