+++ b/src/renderer/link.zig
@@ -10,6 +10,21 @@ const Terminal = terminal.Terminal;
 
 const log = std.log.scoped(.renderer_link);
 
+/// Check a rendered cell against links stored in viewport coordinates.
+pub fn containsRenderCell(
+    matches: *const terminal.RenderState.CellSet,
+    state: *const terminal.RenderState,
+    cell: point.Coordinate,
+) bool {
+    // Guard rows are rendered but are absent from the viewport link map.
+    if (cell.y < state.smooth_scroll.before or
+        cell.y >= state.rows - state.smooth_scroll.after) return false;
+    return matches.contains(.{
+        .x = cell.x,
+        .y = cell.y - state.smooth_scroll.before,
+    });
+}
