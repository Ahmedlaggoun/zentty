+
+test "smooth scroll hyperlink underline follows rendered URL row" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    for ([_]bool{ false, true }) |osc8| {
+        var t: Terminal = try .init(testing.io, alloc, .{
+            .cols = 40,
+            .rows = 4,
+            .max_scrollback_bytes = 10000,
+        });
+        defer t.deinit(alloc);
+        var stream = t.vtStream();
+        defer stream.deinit();
+        stream.nextSlice("history\r\nabove\r\n");
+        if (osc8) stream.nextSlice("\x1b]8;;https://example.com\x1b\\");
+        stream.nextSlice("https://example.com");
+        if (osc8) stream.nextSlice("\x1b]8;;\x1b\\");
+        stream.nextSlice("\r\nbelow\r\nlast");
+
+        var state: terminal.RenderState = .empty;
+        defer state.deinit(alloc);
+        var set = try Set.fromConfig(alloc, &.{.{
+            .regex = "https://example\\.com",
+            .action = .{ .open = {} },
+            .highlight = .{ .hover_mods = inputpkg.ctrlOrSuper(.{}) },
+        }});
+        defer set.deinit(alloc);
+
+        for ([_]f32{ 0, 4, -4, 24, -24 }) |offset| {
+            const guards: terminal.size.CellCountInt = if (offset == 0) 0 else if (@abs(offset) > 20) 2 else 1;
+            try state.updateWithOptions(alloc, &t, .{
+                .smooth_scroll = .{ .offset_y = offset, .before = guards, .after = guards },
+            });
+            const hover: point.Coordinate = .{ .x = 3, .y = 1 };
+            var matches: terminal.RenderState.CellSet = if (osc8)
+                try state.linkCells(alloc, hover)
+            else
+                .empty;
+            defer matches.deinit(alloc);
+            if (!osc8) try set.renderCellMap(alloc, &matches, &state, hover, inputpkg.ctrlOrSuper(.{}));
+            try testing.expectEqual(@as(usize, 19), matches.count());
+            for (0..state.rows) |y| {
+                for (0..state.cols) |x| {
+                    const expected = y == 1 + guards and x < 19;
+                    try testing.expectEqual(expected, containsRenderCell(&matches, &state, .{
+                        .x = @intCast(x),
+                        .y = @intCast(y),
+                    }));
+                }
+            }
+        }
+    }
+}
